# --- Configuración de Base de Datos ---
DB_PASSWORD=
DB_NAME=mareas_db
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
# IMPORTANTE: En producción usar el host 'db' (nombre del servicio en docker-compose)
DATABASE_URL="postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# --- Configuración de la Aplicación ---
PORT=3000
API_DOMAIN=
HOST_API=https://${API_DOMAIN}/api
FRONTEND_URL=https://tusistema.com
GOTENBERG_URL=http://localhost:3003
JWT_SECRET=
BACKUP_SECRET=
BACKUP_ZIP_PASSWORD=
APP_TIMEZONE=America/Argentina/Buenos_Aires
ALERT_CHECK_INTERVAL_MINUTES=15
VESSEL_SYNC_THRESHOLD_DAYS=7
VESSEL_SYNC_RATE_LIMIT_MS=10000
TRACKING_SYNC_RATE_LIMIT_MS=60000

# --- API de Prefectura Naval Argentina ---
