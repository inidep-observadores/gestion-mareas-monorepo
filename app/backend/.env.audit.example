# ============================================
# SISTEMA DE AUDITORÍA
# ============================================

# Nivel de auditoría: ALL (todo) o CRITICAL (solo operaciones críticas)
AUDIT_LEVEL=ALL

# Auditoría de API
AUDIT_API_ENABLED=true
AUDIT_API_INCLUDE_REQUEST_BODY=true
AUDIT_API_INCLUDE_RESPONSE_BODY=true
AUDIT_API_MAX_BODY_SIZE=10000
AUDIT_API_RETENTION_DAYS=90

# Auditoría de Navegación (Frontend)
AUDIT_NAVIGATION_ENABLED=true
AUDIT_NAVIGATION_RETENTION_DAYS=30

# Auditoría de Entidades (Triggers DB)
AUDIT_ENTITIES_ENABLED=true

# Auditoría de Eventos de Negocio
AUDIT_EVENTS_ENABLED=true

# Procesamiento Asíncrono (requiere Redis)
AUDIT_ASYNC_ENABLED=true

# ============================================
# REDIS (para colas asíncronas)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
