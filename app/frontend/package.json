    "jiti": "^2.4.2",
    "jsdom": "^27.4.0",
    "npm-run-all2": "^7.0.2",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "sass-embedded": "^1.83.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.3",
    "vite": "^6.0.11",
