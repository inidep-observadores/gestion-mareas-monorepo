{
  "name": "sigma-mareas-monorepo",
  "version": "0.8.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "workspaces": [
    "app/backend",
    "app/frontend"
  ],
  "scripts": {
    "dev:backend": "pnpm --filter sigma-backend run start:dev",
    "dev:frontend": "pnpm --filter sigma-frontend run dev",
    "dev": "pnpm --filter sigma-backend --filter sigma-frontend --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "prisma:studio": "pnpm --filter sigma-backend exec prisma studio"
  },
  "pnpm": {
    "overrides": {
      "@types/pg": "8.11.11"
    }
  }
}