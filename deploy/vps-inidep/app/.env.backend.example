# =============================================================================
# 1. BASE DE DATOS (PostgreSQL)
# =============================================================================
DB_USERNAME=postgres
DB_PASSWORD=clave_segura_aqui
DB_NAME=mareas_db
DB_HOST=db
DB_PORT=5432
DATABASE_URL="postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"
# Puerto externo para acceso directo desde host/red local (DBeaver)
DB_EXTERNAL_PORT=5437

# =============================================================================
# 2. CONFIGURACIÓN GENERAL DE LA APLICACIÓN Y RED
# =============================================================================
PORT=3000
NODE_ENV=production
APP_TIMEZONE=America/Argentina/Buenos_Aires
API_DOMAIN=10.0.64.46
HOST_API=http://10.0.64.46/api
FRONTEND_URL=http://10.0.64.46

# =============================================================================
# 3. SEGURIDAD DE COOKIES Y SESIÓN
# =============================================================================
# En Fase 1 (Red Local HTTP): COOKIE_SECURE=false y COOKIE_SAMESITE=lax
# En Fase 2 (Puerto 443 HTTPS): COOKIE_SECURE=true y COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# =============================================================================
# 4. SECRETOS DE CRIPTOGRAFÍA Y SESIÓN
# =============================================================================
JWT_SECRET=generar_hash_aleatorio_muy_largo_aqui
BACKUP_SECRET=generar_otro_hash_aleatorio_para_backups
BACKUP_ZIP_PASSWORD=clave_opcional_para_cifrar_zips

# =============================================================================
# 5. SERVICIOS AUXILIARES (Redis y Gotenberg)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
GOTENBERG_URL=http://gotenberg:3000

# =============================================================================
# 6. INTERVALOS Y TAREAS PROGRAMADAS (Cron / Sync)
# =============================================================================
ALERT_CHECK_INTERVAL_MINUTES=15
VESSEL_SYNC_THRESHOLD_DAYS=30
VESSEL_SYNC_RATE_LIMIT_MS=15000
TRACKING_SYNC_RATE_LIMIT_MS=60000
JOB_SCHEDULER_INTERVAL_CRON="*/5 * * * *"
JOB_STALE_THRESHOLD_HOURS=24

# =============================================================================
# 7. PREFECTURA NAVAL ARGENTINA (PNA API)
# =============================================================================
USE_MOCK_FISHERY_API=true
PNA_API_USER=
PNA_API_PASSWORD=
PNA_API_ENDPOINT=https://sscpwsexternos.prefecturanaval.gob.ar/WsPescaExternos.asmx
PNA_API_TIMEOUT=60000
PNA_API_SYNC_RATE_LIMIT_MS=10000
PNA_API_SYNC_SAFE_RANGE_DAYS=20

# =============================================================================
# 8. CORREO SALIENTE (Envío - SMTP)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="SIGMA INIDEP <no-reply@inidep.edu.ar>"

# =============================================================================
# 9. CORREO ENTRANTE (Recepción - IMAP)
# =============================================================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# =============================================================================
# 10. GOOGLE DRIVE (Subida y Almacenamiento)
# =============================================================================
GOOGLE_APPLICATION_CREDENTIALS="./google-credentials.json"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_DRIVE_NOVEDADES_FOLDER_ID=""
GOOGLE_DRIVE_MAREAS_FOLDER_ID=""

# =============================================================================
# 11. PROTOCOLIZACIÓN DE MAREAS
# =============================================================================
PROTOCOLIZACION_EMAIL_TO=daniel.dt.inidep@gmail.com
PROTOCOLIZACION_EMAIL_CC=

# =============================================================================
# 12. RUTAS DE ARCHIVOS DEL SISTEMA
# =============================================================================
STATIC_PATH="./static"
UPLOADS_PATH="./uploads"
BACKUP_PATH="./backups"
MAREA_INFORMES_DIR="uploads/informes_marea"

# =============================================================================
# 13. MODELOS DE INTELIGENCIA ARTIFICIAL (LLMs)
# =============================================================================
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
LLM_API_KEY=
OPENAI_BASE_URL="https://api.ollama.cloud/v1"
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
LLM_MODEL="gemini-3.1-flash-lite"
LLM_FALLBACK_MODEL="gemma-4-31b"

# =============================================================================
# 14. RETENCIÓN DE LOGS
# =============================================================================
EMAIL_LOGS_RETENTION_DAYS=90

# =============================================================================
# 15. SISTEMA DE AUDITORÍA
# =============================================================================
AUDIT_ENABLED=true
AUDIT_LEVEL=ALL
AUDIT_ASYNC_ENABLED=true
AUDIT_API_ENABLED=true
AUDIT_API_INCLUDE_REQUEST_BODY=true
AUDIT_API_INCLUDE_RESPONSE_BODY=true
AUDIT_API_MAX_BODY_SIZE=10000
AUDIT_API_RETENTION_DAYS=90
AUDIT_NAVIGATION_ENABLED=true
AUDIT_NAVIGATION_RETENTION_DAYS=30
AUDIT_ENTITIES_ENABLED=true
AUDIT_EVENTS_ENABLED=true
